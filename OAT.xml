<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
    <licensefile>log/License.txt</licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="GPLStyleLicense" path="AUTHORS" desc="" />
                <policyitem type="compatibility" name="LGPL-2.1+" path=".*" desc="" />
                <policyitem type="compatibility" name="GPL-2.0-or-later" path=".*" desc="" />
                <policyitem type="compatibility" name="GFDL-1.2" path=".*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="README.chromium"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter> 
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="LGPL-2.1-only" desc="">
                <licensetext name="
                51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
                Everyone is permitted to copy and distribute verbatim copies
                of this license document, but changing it is not allowed.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>